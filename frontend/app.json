{
  "expo": {
    "name": "EVA Banking",
    "slug": "eva-banking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "eva-banking",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F5FA",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F5FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eva.banking"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F5FA"
      },
      "package": "com.eva.banking"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F5FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
